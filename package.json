{
  "name": "dsh-pinned-sessions",
  "version": "0.2.0",
  "description": "Keeps running, finished-but-unopened and currently open sessions at the top of the DSH Web sidebar workspace list.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianYa-DAO/dsh-pinned-sessions.git"
  },
  "homepage": "https://github.com/TianYa-DAO/dsh-pinned-sessions#readme",
  "bugs": {
    "url": "https://github.com/TianYa-DAO/dsh-pinned-sessions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "sessions",
    "pinned"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "tests"
  ],
  "scripts": {
    "test": "node tests/selfcheck.cjs"
  },
  "dsh": {
    "id": "dsh-pinned-sessions",
    "name": "Pinned sessions",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
